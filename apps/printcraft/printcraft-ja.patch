@@ -0,0 +1,69 @@
+//! Japanese (CJK) fallback font for the UI.
+//!
+//! The bundled Inter / JetBrains Mono have no kana or kanji (unless the craft-fonts faces are built in; then this is a no-op). When the UI language is Japanese a
+//! system font that has them is read once (they are 10-20 MB, so never at startup for English)
+//! and registered at the lowest priority in every family, so Latin text keeps Inter.
+
+use std::path::PathBuf;
+
+use egui::epaint::text::{FontInsert, FontPriority, InsertFontFamily};
+use egui::{FontData, FontFamily};
+
+/// Candidate files in preference order: (path, face index).
+fn candidates() -> Vec<(PathBuf, u32)> {
+    let mut v: Vec<(PathBuf, u32)> = Vec::new();
+    if let Ok(p) = std::env::var("PRINTCRAFT_CJK_FONT") {
+        v.push((PathBuf::from(p), 0));
+    }
+    for p in [
+        // macOS: Hiragino Kaku Gothic (face 0 is the Japanese design)
+        "/System/Library/Fonts/ヒラギノ角ゴシック W3.ttc",
+        "/System/Library/Fonts/ヒラギノ角ゴシック W4.ttc",
+        "/System/Library/Fonts/ヒラギノ角ゴシック W2.ttc",
+        "/Library/Fonts/Arial Unicode.ttf",
+        // Windows
+        "C:\\Windows\\Fonts\\YuGothR.ttc",
+        "C:\\Windows\\Fonts\\meiryo.ttc",
+        "C:\\Windows\\Fonts\\msgothic.ttc",
+        // Linux
+        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/google-noto-cjk/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/opentype/ipafont-gothic/ipag.ttf",
+        "/usr/share/fonts/truetype/fonts-japanese-gothic.ttf",
+    ] {
+        v.push((PathBuf::from(p), 0));
+    }
+    v
+}
+
+/// Register a CJK fallback font (once per process run of the flag).
+pub fn ensure_loaded(ctx: &egui::Context, loaded: &mut bool) {
+    if *loaded {
+        return;
+    }
+    *loaded = true;
+    // The optional craft-fonts build input already puts Japanese faces into every family.
+    if !printcraft_fonts::ui_japanese_fonts().is_empty() {
+        return;
+    }
+    for (path, index) in candidates() {
+        let Ok(meta) = std::fs::metadata(&path) else { continue };
+        if !meta.is_file() || meta.len() == 0 || meta.len() > (128 << 20) {
+            continue;
+        }
+        let Ok(bytes) = std::fs::read(&path) else { continue };
+        let mut data = FontData::from_owned(bytes);
+        data.index = index;
+        log::info!("UI font fallback: {}", path.display());
+        let families = [FontFamily::Proportional, FontFamily::Monospace, FontFamily::Name("semibold".into()), FontFamily::Name("medium".into())]
+            .into_iter()
+            .map(|family| InsertFontFamily { family, priority: FontPriority::Lowest })
+            .collect();
+        ctx.add_font(FontInsert { name: "system-cjk".into(), data, families });
+        ctx.request_repaint();
+        return;
+    }
+    log::warn!("no Japanese UI font found; set PRINTCRAFT_CJK_FONT to a .ttf/.ttc path");
+}
