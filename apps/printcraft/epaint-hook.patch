+/// PrintCraft local patch: a process-wide text translator applied to every laid-out section.
+/// Returns `None` for text it does not translate. Install once at startup with
+/// [`set_text_translator`]; with none installed (or `enabled == false`) layout is unchanged.
+pub type TextTranslator = fn(&str) -> Option<String>;
+
+static TRANSLATOR: std::sync::OnceLock<TextTranslator> = std::sync::OnceLock::new();
+static TRANSLATE_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Install the translator (first call wins).
+pub fn set_text_translator(f: TextTranslator) {
+    let _ = TRANSLATOR.set(f);
+}
+
+/// Turn translation on or off (e.g. when the UI language changes).
+pub fn set_text_translation_enabled(on: bool) {
+    TRANSLATE_ON.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn translate_job(mut job: LayoutJob) -> LayoutJob {
+    if !TRANSLATE_ON.load(std::sync::atomic::Ordering::Relaxed) || job.text.is_ascii() && job.text.trim().is_empty() {
+        return job;
+    }
+    let Some(tr) = TRANSLATOR.get() else { return job };
+    // Whole text first (single section or a plain match), then section by section.
+    if let Some(t) = tr(&job.text) {
+        if job.sections.len() <= 1 {
+            let len = t.len();
+            job.text = t;
+            if let Some(s) = job.sections.first_mut() {
+                s.byte_range = ByteIndex(0)..ByteIndex(len);
+            }
+            return job;
+        }
+    }
+    if job.sections.len() < 2 {
+        return job;
+    }
+    let mut changed = false;
+    let mut text = String::with_capacity(job.text.len());
+    let mut ranges = Vec::with_capacity(job.sections.len());
+    for s in &job.sections {
+        let src = s.byte_range.slice(&job.text);
+        let start = text.len();
+        match tr(src) {
+            Some(t) => {
+                changed = true;
+                text.push_str(&t);
+            }
+            None => text.push_str(src),
+        }
+        ranges.push(ByteIndex(start)..ByteIndex(text.len()));
+    }
+    if changed {
+        for (s, r) in job.sections.iter_mut().zip(ranges) {
+            s.byte_range = r;
+        }
+        job.text = text;
+    }
+    job
+}
